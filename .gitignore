# Secrets and configuration
.env

# Runtime directories
uploads/
templates/

# Extensions: track source, not installed packages or build output.
extensions/*/node_modules/
extensions/*/dist/

# Case data may contain survivor and perpetrator PII — never commit it.
# These rules are a safety net, not a policy: keep case data outside the repository.
*.xlsx
*.xlsm
*.xls
*.ods
*.csv
*.tsv
data/

# Database dumps, backups, and exports — a dump contains all PII in plaintext
*.sql
!scripts/migrations.sql
*.dump
*.bak
*.backup
backup*
*.zip
*.tar
*.tar.gz

# Screenshots and documents can contain PII
*.png
*.jpg
*.jpeg
*.pdf

# JSON is Directus's export format, so a collection dump lands here by default.
*.json
!extensions/*/package.json
!extensions/*/package-lock.json

# Generated locally
docs/demo_manifest.json

# Editor and OS artefacts
.DS_Store
__pycache__/
*.pyc
.venv/
.idea/
.vscode/
