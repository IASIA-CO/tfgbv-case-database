# Copy this file to .env and fill in every value. Never commit .env.
#
#   cp .env.example .env

# 32+ random bytes used to sign auth tokens. Generate with:
#   openssl rand -hex 32
SECRET=

# The URL used to build links in emails (password reset, user invites).
# Must match how you actually reach Directus. For local Docker Compose, this
# is the host-mapped port below (8057), not the container's internal 8055.
PUBLIC_URL=http://localhost:8057

# Creates the first administrator. Only takes effect on an empty database —
# changing these later does nothing. Change the password from inside the app.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=

# PostgreSQL credentials for the `database` service.
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=

# Optional: sender address on outgoing email. In this stack, all email is
# caught locally by Mailpit (http://localhost:8027) — nothing is ever sent
# to a real inbox, so this can stay at its default.
# EMAIL_FROM=no-reply@odc-tfgbv.local
